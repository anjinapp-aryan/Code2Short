# =====================================================================
# Code2Shorts — PRODUCTION CONFIGURATION CONTRACT (template, committed)
# =====================================================================
#
# This file documents WHICH variables production needs. It contains no
# real values and must never contain any.
#
# Preferred deployment: inject these as real environment variables from
# your secret manager (AWS Secrets Manager, GCP Secret Manager, Azure Key
# Vault, Kubernetes Secret, Docker secret, CI secret store). Do NOT copy
# this file to `.env.production` on the server unless your deployment
# mechanism has no other way to supply environment variables — and if you
# do, that file is gitignored and must stay off version control.
#
# Code2Shorts reads NO dotenv file when CODE2SHORTS_ENV=production. That is
# deliberate: dotenv paths resolve against the working directory, so a
# production process started inside a developer checkout would otherwise
# silently inherit `.env.local` and run on a personal key.
#
# Precedence: process environment > env files > defaults.
# In production only the first and last apply.

# ---------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------
# REQUIRED in production. Disables all dotenv loading.
CODE2SHORTS_ENV=production

# ---------------------------------------------------------------------
# Provider selection
# ---------------------------------------------------------------------
#   mock              no credentials, deterministic (safe default)
#   gemini            direct Google Gemini
#   xai               xAI/Grok
#   omniroute         self-hosted OpenAI-compatible gateway
#   openai_compatible any OpenAI-compatible /v1 endpoint
LLM_PROVIDER=gemini

# ---------------------------------------------------------------------
# Google Gemini — required when LLM_PROVIDER=gemini
# ---------------------------------------------------------------------
GEMINI_API_KEY=<INJECT_FROM_SECRET_MANAGER>
# Google retires model ids. Verify yours is still served before deploying:
#   GET https://generativelanguage.googleapis.com/v1beta/models
# `gemini-2.5-flash` returns 404 "no longer available to new users".
GEMINI_MODEL=gemini-3.6-flash

# ---------------------------------------------------------------------
# xAI / Grok — required when LLM_PROVIDER=xai
# ---------------------------------------------------------------------
# xAI keys begin `xai-`. A `gsk_` prefix is a Groq key and will be
# rejected by api.x.ai with "Incorrect API key provided".
XAI_API_KEY=<INJECT_FROM_SECRET_MANAGER>
GROK_MODEL=grok-4.1-fast

# ---------------------------------------------------------------------
# OmniRoute / any OpenAI-compatible gateway
# ---------------------------------------------------------------------
# Only needed when LLM_PROVIDER=omniroute or openai_compatible.
# `openai_compatible` REQUIRES a base URL; `omniroute` defaults to
# http://localhost:20128/v1.
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=<INJECT_FROM_SECRET_MANAGER_IF_THE_GATEWAY_NEEDS_ONE>
OMNIROUTE_MODEL=

# ---------------------------------------------------------------------
# Optional fallback
# ---------------------------------------------------------------------
# Validated at startup: if set to a provider that needs a credential, that
# credential must also be present.
#
# IMPORTANT: this declares INTENT only. No automatic runtime failover is
# implemented — switching provider mid-run would change an artifact's
# recorded producer and mask a failing primary. See
# docs/PHASE_5_PROVIDER_CONFIGURATION.md.
LLM_FALLBACK_PROVIDER=

# ---------------------------------------------------------------------
# Timeouts and bounds (safe to commit — no secrets)
# ---------------------------------------------------------------------
# 30s suits a paid endpoint. Free-tier routing needs 180-300.
CODE2SHORTS_AI_TIMEOUT_SECONDS=60
CODE2SHORTS_AI_MAX_RETRIES=2
CODE2SHORTS_AI_MAX_REPAIR_ATTEMPTS=2
CODE2SHORTS_VIDEO_RESOLUTION=1080x1920
CODE2SHORTS_VIDEO_FPS=30
CODE2SHORTS_OUTPUT_DIRECTORY=output
CODE2SHORTS_TTS_PROVIDER=mock
