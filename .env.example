# Copy to .env (or .env.local) and fill in as needed.
# `.env.local` is read AFTER `.env` and wins - it is the conventional
# place for real keys. Every `.env*` except this file is gitignored.
# Prefixed names beat unprefixed ones, so do NOT leave a stale
# CODE2SHORTS_LLM_PROVIDER=mock above an LLM_PROVIDER=gemini.
# LLM provider. Defaults to `mock` in code so a fresh checkout needs NO
# credentials: the unit suite and the mock golden path run as-is.
#   mock              deterministic, credential-free (default)
#   omniroute         local OpenAI-compatible gateway, no key needed
#   openai_compatible any /v1 endpoint - set CODE2SHORTS_LLM_BASE_URL
#   gemini            direct Gemini, requires a key
#   xai               xAI/Grok - just another OpenAI-compatible base_url
CODE2SHORTS_LLM_PROVIDER=mock
CODE2SHORTS_LLM_MODEL=llama3.1

# Any OpenAI-compatible /v1 endpoint. This single setting is the whole
# multi-provider story - there is no per-vendor code (see ADR-5.1/5.2).
#   OmniRoute  http://localhost:20128/v1   (default when provider=omniroute)
#   Ollama     http://localhost:11434/v1
#   vLLM       http://localhost:8000/v1
CODE2SHORTS_LLM_BASE_URL=
# Left blank for keyless local gateways; sent as a placeholder if unset.
# Never commit a real key. It is excluded from provenance, errors and logs.
CODE2SHORTS_LLM_API_KEY=
OLLAMA_API_BASE=http://localhost:11434

# Optional cloud providers. The unprefixed vendor names below are read
# too, so an existing .env.local works without renaming anything.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
GROK_MODEL=grok-4.1-fast

# Execution sandbox
CODE2SHORTS_JAVA_HOME=
CODE2SHORTS_EXECUTION_TIMEOUT_SECONDS=10
CODE2SHORTS_BUILD_TIMEOUT_SECONDS=120

# Phase 4: AI provider, rendering, TTS. GEMINI_API_KEY above is read
# directly by GeminiLLMProvider if CODE2SHORTS_GEMINI_API_KEY isn't set.
# Google retires model ids: `gemini-2.5-flash` now 404s for new users
# with "no longer available". Check what your key can see rather than
# assuming - GET /v1beta/models lists it.
CODE2SHORTS_GEMINI_MODEL=gemini-3.6-flash
# 30s is fine for a paid endpoint. Free-tier routing is far slower -
# a full-trace explanation prompt routinely exceeds it; use 180-300.
CODE2SHORTS_AI_TIMEOUT_SECONDS=30
CODE2SHORTS_AI_MAX_RETRIES=2
CODE2SHORTS_AI_MAX_REPAIR_ATTEMPTS=2
CODE2SHORTS_VIDEO_RESOLUTION=1080x1920
CODE2SHORTS_VIDEO_FPS=30
CODE2SHORTS_OUTPUT_DIRECTORY=output
CODE2SHORTS_TTS_PROVIDER=mock
