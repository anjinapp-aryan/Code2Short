# =====================================================================
# Code2Shorts — DEVELOPER CONFIGURATION TEMPLATE (committed, no secrets)
# =====================================================================
#
# Copy to `.env.local` and put your real keys there. `.env.local` is
# gitignored; this file must never contain a real credential.
#
# Loading, by environment (CODE2SHORTS_ENV):
#   local (default)  reads .env, then .env.local   <- your keys
#   test / ci        reads nothing                 <- deterministic pytest
#   production/prod  reads nothing                 <- runtime injection only
#
# Precedence: process environment > env files > defaults.
#
# GOTCHA: the CODE2SHORTS_-prefixed name always beats the unprefixed one.
# Do not leave a stale `CODE2SHORTS_LLM_PROVIDER=mock` above your
# `LLM_PROVIDER=gemini` — the stale line wins and you will wonder why the
# mock provider ran.
#
# For deployment see .env.production.example and
# docs/PHASE_5_PROVIDER_CONFIGURATION.md.

# ---------------------------------------------------------------------
# Provider selection
# ---------------------------------------------------------------------
#   mock              deterministic, credential-free (default)
#   gemini            direct Google Gemini, needs a key
#   xai               xAI/Grok, needs a key
#   omniroute         local OpenAI-compatible gateway, usually keyless
#   openai_compatible any /v1 endpoint — requires a base URL
LLM_PROVIDER=mock

# ---------------------------------------------------------------------
# Google Gemini
# ---------------------------------------------------------------------
GEMINI_API_KEY=
# Google retires model ids. `gemini-2.5-flash` now 404s for new users with
# "no longer available". List what your key can actually see:
#   GET https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-3.6-flash

# ---------------------------------------------------------------------
# xAI / Grok
# ---------------------------------------------------------------------
# xAI keys begin `xai-`. A `gsk_` prefix is a Groq key and api.x.ai will
# reject it with "Incorrect API key provided".
XAI_API_KEY=
GROK_MODEL=grok-4.1-fast

# ---------------------------------------------------------------------
# OmniRoute / any OpenAI-compatible gateway
# ---------------------------------------------------------------------
# This single setting is the whole multi-provider story — there is no
# per-vendor code (ADR-5.1/5.2).
#   OmniRoute  http://localhost:20128/v1   (default when provider=omniroute)
#   Ollama     http://localhost:11434/v1
#   vLLM       http://localhost:8000/v1
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=

# ---------------------------------------------------------------------
# Optional fallback
# ---------------------------------------------------------------------
# Validated at startup, but declares INTENT only — no automatic runtime
# failover is implemented. See docs/PHASE_5_PROVIDER_CONFIGURATION.md §9.
LLM_FALLBACK_PROVIDER=

# ---------------------------------------------------------------------
# Execution sandbox
# ---------------------------------------------------------------------
CODE2SHORTS_JAVA_HOME=
CODE2SHORTS_EXECUTION_TIMEOUT_SECONDS=10
CODE2SHORTS_BUILD_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------
# AI, rendering, TTS
# ---------------------------------------------------------------------
# 30s suits a paid endpoint. Free-tier routing is far slower — a
# full-trace explanation prompt routinely exceeds it; use 180-300.
CODE2SHORTS_AI_TIMEOUT_SECONDS=30
CODE2SHORTS_AI_MAX_RETRIES=2
CODE2SHORTS_AI_MAX_REPAIR_ATTEMPTS=2
CODE2SHORTS_VIDEO_RESOLUTION=1080x1920
CODE2SHORTS_VIDEO_FPS=30
CODE2SHORTS_OUTPUT_DIRECTORY=output
CODE2SHORTS_TTS_PROVIDER=mock

# ---------------------------------------------------------------------
# Narration voice (local neural TTS). No credential of any kind.
# ---------------------------------------------------------------------
# Kokoro runs entirely offline from models/kokoro/; there is no API key
# and no network call at synthesis time.
#
# af_heart is the narrator selected for Code2Shorts by listening. Any
# packaged voice works here (am_michael, bf_emma, af_bella, ...) without
# a source change. Naming one matters for reproducibility: a video must
# not change narrator between runs.
CODE2SHORTS_KOKORO_VOICE=af_heart
